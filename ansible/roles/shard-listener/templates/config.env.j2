# shard-listener environment configuration
# Managed by Ansible — do not edit manually

MULTICAST_IF={{ ingress_iface if ingress_iface is string else ingress_iface[0] }}
LISTEN_PORT={{ listen_port }}
SHARD_BITS={{ shard_bits }}
MC_SCOPE={{ mc_scope }}
MC_GROUP_ID={{ mc_group_id }}
LISTENER_MODE={{ listener_mode | default('collapsed') }}
DELIVERY_ADDRS={{ delivery_addrs | default('') }}
SOURCE_MODE={{ source_mode | default('asm') }}
SSM_BOOTSTRAP_BEACON={{ ssm_bootstrap_beacon | default('') }}
SSM_BOOTSTRAP_MANIFEST={{ ssm_bootstrap_manifest | default('') }}
SSM_BOOTSTRAP_SUBTREE_ANNOUNCE={{ ssm_bootstrap_subtree_announce | default('') }}
SSM_BOOTSTRAP_REFRESH={{ ssm_bootstrap_refresh | default('30s') }}
SHARD_INCLUDE={{ shard_include }}
SUBTREE_INCLUDE={{ subtree_include }}
{% if beef_topics | default('') %}BEEF_TOPICS={{ beef_topics }}
{% endif %}{% if beef_groups | default('') %}BEEF_GROUPS={{ beef_groups }}
{% endif %}BEEF_SHARD_BITS={{ beef_shard_bits | default(0) }}
{% if beef_versions | default('') %}BEEF_VERSIONS={{ beef_versions }}
{% endif %}BEEF_VERIFY_CONTENT={{ 'true' if beef_verify_content | default(false) else 'false' }}
SUBTREE_EXCLUDE={{ subtree_exclude }}
EGRESS_ADDR={{ egress_addr }}
EGRESS_PROTO={{ egress_proto }}
STRIP_HEADER={{ 'true' if strip_header else 'false' }}
RETRY_ENDPOINTS={{ retry_endpoints }}
{# Receive-side retry tee: mirror received data frames to a co-resident
   retry-endpoint's -tee-listen. Env key (older binaries ignore it); rendered
   only when set — byte-identical default. #}
{% if retry_tee_listen | default('') %}
RETRY_TEE={{ retry_tee_listen }}
{% endif %}
NACK_JITTER_MAX={{ nack_jitter_max }}
NACK_BACKOFF_MAX={{ nack_backoff_max }}
NACK_MAX_RETRIES={{ nack_max_retries }}
NACK_GAP_TTL={{ nack_gap_ttl }}
{# Optional NACK tuning: rendered only when set away from the binary default. #}
{% if nack_backoff_base | default('500ms') != '500ms' %}
NACK_BACKOFF_BASE={{ nack_backoff_base }}
{% endif %}
{% if nack_max_flows | default(100000) | int != 100000 %}
NACK_MAX_FLOWS={{ nack_max_flows }}
{% endif %}
{% if nack_max_forward_jump | default(4096) | int != 4096 %}
NACK_MAX_FORWARD_JUMP={{ nack_max_forward_jump }}
{% endif %}
{% if not (nack_tail_probe | default(true)) %}
NACK_TAIL_PROBE=false
{% endif %}
{% if nack_tail_probe_idle_factor | default(4.0) | float != 4.0 %}
NACK_TAIL_PROBE_IDLE_FACTOR={{ nack_tail_probe_idle_factor }}
{% endif %}
{% if nack_tail_probe_min_idle | default('500ms') != '500ms' %}
NACK_TAIL_PROBE_MIN_IDLE={{ nack_tail_probe_min_idle }}
{% endif %}
{% if nack_tail_probe_max_misses | default(3) | int != 3 %}
NACK_TAIL_PROBE_MAX_MISSES={{ nack_tail_probe_max_misses }}
{% endif %}
BEACON_ENABLED={{ 'true' if beacon_enabled else 'false' }}
BEACON_PORT={{ beacon_port }}
BEACON_SCOPE={{ beacon_scope }}
SUBTREE_GROUPS={{ subtree_groups }}
SUBTREE_GROUP_DEFAULT_TTL={{ subtree_group_default_ttl }}
ANNOUNCE_SCOPE={{ announce_scope }}
SENDER_INCLUDE={{ sender_include }}
SENDER_EXCLUDE={{ sender_exclude }}
NUM_WORKERS={{ num_workers }}
METRICS_ADDR={{ metrics_addr }}
OTLP_ENDPOINT={{ otlp_endpoint }}
OTLP_INTERVAL={{ otlp_interval }}
LOG_FORMAT={{ log_format }}
LOG_LEVEL={{ log_level }}
TRACE_SAMPLING={{ trace_sampling }}
DRAIN_TIMEOUT={{ drain_timeout }}
INSTANCE_ID={{ instance_id }}
DEBUG={{ 'true' if listener_debug else 'false' }}
VERIFY_PAYLOAD_HASH={{ 'true' if verify_payload_hash else 'false' }}
REQUIRE_BLOCK_POW={{ 'true' if require_block_pow | default(true) else 'false' }}
MIN_POW_BITS={{ min_pow_bits | default('0') }}
MC_EGRESS_ENABLED={{ 'true' if mc_egress_enabled else 'false' }}
MC_EGRESS_IFACE={{ mc_egress_iface }}
MC_EGRESS_PORT={{ mc_egress_port }}
MC_EGRESS_SCOPE={{ mc_egress_scope }}
MC_EGRESS_GROUP_ID={{ mc_egress_group_id }}
MC_EGRESS_HOPLIMIT={{ mc_egress_hoplimit }}
HEADER_EGRESS_ENABLED={{ 'true' if header_egress_enabled | default(false) else 'false' }}
HEADER_EGRESS_ADDR={{ header_egress_addr | default('127.0.0.1:9101') }}
HEADER_EGRESS_PROTO={{ header_egress_proto | default('udp') }}
HEADER_MC_EGRESS_ENABLED={{ 'true' if header_mc_egress_enabled | default(false) else 'false' }}
HEADER_MC_EGRESS_IFACE={{ header_mc_egress_iface | default('') }}
HEADER_MC_EGRESS_PORT={{ header_mc_egress_port | default(0) }}
HEADER_MC_EGRESS_SCOPE={{ header_mc_egress_scope | default('') }}
HEADER_MC_EGRESS_GROUP_ID={{ header_mc_egress_group_id | default('') }}
HEADER_MC_EGRESS_HOPLIMIT={{ header_mc_egress_hoplimit | default(1) }}
DEPLOYMENT_ID={{ deployment_id | default('') }}
NODE_ID={{ node_id | default('') }}
{% if egress_dedup_backend | default('') %}
EGRESS_DEDUP_BACKEND={{ egress_dedup_backend }}
{% endif %}
EGRESS_DEDUP_REDIS_ADDR={{ egress_dedup_redis_addr | default('') }}
{% if egress_dedup_aerospike_hosts | default('') %}
EGRESS_DEDUP_AEROSPIKE_HOSTS={{ egress_dedup_aerospike_hosts }}
EGRESS_DEDUP_AEROSPIKE_NAMESPACE={{ egress_dedup_aerospike_namespace | default('cache') }}
EGRESS_DEDUP_AEROSPIKE_SET={{ egress_dedup_aerospike_set | default('bsl-egr') }}
{% endif %}
EGRESS_DEDUP_PREFIX={{ egress_dedup_prefix | default('bsl:egr:') }}
EGRESS_DEDUP_TTL_REDIS={{ egress_dedup_ttl_redis | default('60s') }}
EGRESS_DEDUP_LOCAL_CAP={{ egress_dedup_local_cap | default(1048576) }}
# In-process (groupIdx, subtreeID, SeqNum) duplicate suppressor — a separate
# feature from the cross-listener TxID gate above. Cap 0 disables it.
EGRESS_DEDUP_CAP={{ egress_dedup_cap | default(0) }}
EGRESS_DEDUP_TTL={{ egress_dedup_ttl | default('2s') }}
{% if ingress_set_backend | default('') %}
INGRESS_SET_BACKEND={{ ingress_set_backend }}
{% endif %}
INGRESS_SET_REDIS_ADDR={{ ingress_set_redis_addr | default('') }}
{% if ingress_set_aerospike_hosts | default('') %}
INGRESS_SET_AEROSPIKE_HOSTS={{ ingress_set_aerospike_hosts }}
INGRESS_SET_AEROSPIKE_NAMESPACE={{ ingress_set_aerospike_namespace | default('cache') }}
INGRESS_SET_AEROSPIKE_SET={{ ingress_set_aerospike_set | default('bsp-tx') }}
{% endif %}
INGRESS_SET_PREFIX={{ ingress_set_prefix | default('bsp:tx:') }}
INGRESS_SET_TTL={{ ingress_set_ttl | default('10m') }}
INGRESS_SET_LOCAL_CAP={{ ingress_set_local_cap | default(1048576) }}
{% if subtree_data_enabled | default(false) %}
SUBTREE_DATA_ENABLED=true
{% endif %}
{% if manifest_consumer_enabled | default(false) %}
MANIFEST_CONSUMER_ENABLED=true
{% endif %}
{% if shard_include_from_manifest | default(false) %}
SHARD_INCLUDE_FROM_MANIFEST=true
{% endif %}
